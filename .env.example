# Full mode is the default when this file is copied to .env.
COMPOSE_PROFILES=azure
QUEUE_DRIVER=servicebus
SCHEDULER_DRIVER=pg
OFFER_TIMEOUT_SECONDS=30

POSTGRES_DB=resgata
POSTGRES_USER=resgata
POSTGRES_PASSWORD=resgata_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://resgata:resgata_dev@localhost:5432/resgata

MSSQL_SA_PASSWORD=Resgata!Dev2026
MSSQL_PORT=1433
SERVICEBUS_AMQP_PORT=5672
SERVICEBUS_HTTP_PORT=5300
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://servicebus;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

AZURITE_BLOB_PORT=10000
AZURITE_QUEUE_PORT=10001
AZURITE_TABLE_PORT=10002
AZURITE_ACCOUNT_KEY=bG9jYWwtcmVzZ2F0YS1henVyaXRlLWtleS0yMDI2
AZURE_WEBJOBS_STORAGE=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=bG9jYWwtcmVzZ2F0YS1henVyaXRlLWtleS0yMDI2;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;

GATEWAY_PORT=8080
WEB_PORT=5173
API_PORT=7071
MOCK_OPENAI_PORT=4001
MOCK_MAPS_PORT=4002
MOCK_ACS_PORT=4003

# Real food-photo analysis. Leave empty to use the SIMULADO classifier.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Sign-in. Set ENABLE_DEMO_LOGIN=false and ENABLE_DEV_LOGIN_CODES=false in production.
ENABLE_DEMO_LOGIN=true
ENABLE_DEV_LOGIN_CODES=true

# Addresses (ViaCEP + OpenStreetMap Nominatim) and road ETAs (OSRM).
# The public OSRM/Nominatim servers are for light use; self-host for production.
GEO_PROVIDER=auto
ROUTING_PROVIDER=osrm
OSRM_URL=https://router.project-osrm.org

# Notifications: acs-mock (local outbox at :4003) or whatsapp (Meta Cloud API).
NOTIFICATION_PROVIDER=acs-mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with a single body variable {{1}}; required for messages
# sent outside WhatsApp's 24-hour customer service window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

OPENAI_BASE_URL=http://localhost:4001
OPENAI_API_KEY=local-simulated-key
MAPS_BASE_URL=http://localhost:4002
ACS_BASE_URL=http://localhost:4003
