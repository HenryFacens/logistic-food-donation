{
  "name": "@resgata/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "oxlint -c .oxlintrc.json src && pnpm lint:boundaries",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@resgata/shared": "workspace:*",
    "@tanstack/react-query": "5.104.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.0.0"
  }
}
